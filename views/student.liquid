{% render 'partials/head.liquid' %}

{% comment %} Styling voor de H1 die de favoriete kleur pakt van de student en dat als text shadow zet {% endcomment %}
<h1 class="student-heading" style="text-shadow:
    -2px -2px 0 {{ person.fav_color }},
    2px -2px 0 {{ person.fav_color }},
    -2px  2px 0 {{ person.fav_color }},
    2px  2px 0 {{ person.fav_color }},
    4px  4px 0 {{ person.fav_color }}"
    >{{ person.name }}</h1>

{% comment %} Back button om terug te kunnen gaan naar de home pagina {% endcomment %}
<a href="/" class="back">Back</a>

{% comment %} Chat pagina {% endcomment %}
<div class="chat-page">
    {% comment %} Message box {% endcomment %}
    <section class="messages">
        <h2 class="chat-title">Chat</h2>
        {% for message in messages %}
        <p>{{ message.from }}: {{ message.text }} @{{ message.created | date: '%d-%m-%Y %H:%M' }}</p>
        {% else %}
        <p>Er zijn nog geen berichten voor deze persoon.</p>
        {% endfor %}
    </section>

    {% comment %} Chat input {% endcomment %}
    <section class="chat">
    <h2>Voeg een bericht toe</h2>
    <form method="post" action="/student/{{ person.id }}">
        <label>
        Naam:
        <input type="text" name="from" required>
        </label>
        <label>
        Bericht:
        <textarea name="text" required></textarea>
        </label>
        <button type="submit">Verstuur</button>
    </form>
    </section>
</div>
{% render 'partials/foot.liquid', squads: squads %}